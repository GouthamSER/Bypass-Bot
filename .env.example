# Telegram credentials from https://my.telegram.org and @BotFather
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# Runtime limits
MAX_CONCURRENT=5
REQUEST_TIMEOUT=20
MAX_REDIRECTS=8
MAX_LINKS=12
PORT=8080
CACHE_TTL=600
USER_COOLDOWN=3
# Optional: restrict to these Telegram user IDs (comma-separated)
# ALLOWED_USERS=123456789
LOG_LEVEL=INFO

# Optional: override the honest default User-Agent
# USER_AGENT=Mozilla/5.0 (compatible; MultiHostLinkInspector/1.0)

# Optional: comma-separated additional GDFlix domains (hostnames only)
# GDFLIX_DOMAINS=new8.gdflix.io,gdflix.dev,gdflix.io,gdflix.net

# Optional: press GDFlix "Generate ... Link" buttons in a headless browser.
# Needs: pip install -r requirements-browser.txt && playwright install chromium
# (Docker: build with --build-arg WITH_BROWSER=1). Stops if an anti-bot challenge appears.
# AUTO_CLICK=1
# AUTO_CLICK_TIMEOUT=60
# AUTO_CLICK_MAX=1
