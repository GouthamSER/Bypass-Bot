# Get these from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# Optional: maximum number of concurrent page inspections
MAX_CONCURRENT=5
REQUEST_TIMEOUT=20
MAX_REDIRECTS=8
MAX_LINKS=12

# Health-check port (Docker/Koyeb/Render)
PORT=8080

# Optional: override User-Agent
# USER_AGENT=Mozilla/5.0
